    EOS_Achievements_PlayerAchievement_Release
    EOS_Achievements_QueryDefinitions
    EOS_Achievements_QueryPlayerAchievements
    EOS_Achievements_UnlockAchievements
    EOS_Auth_AddNotifyLoginStatusChanged
