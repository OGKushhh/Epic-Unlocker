; ScreamAPI.def — Native exports only (intercepted by eos-impl/ code)
; Forwarded exports are handled by #pragma comment(linker) in LinkerExports64.h
;
; This file exists to fix the linker shadowing bug: #pragma comment directives
; were overriding __declspec(dllexport) on eos-impl/ wrapper functions.
; The .def file takes precedence over pragmas, forcing these symbols to
; resolve to the C++ implementations in eos-impl/ instead of being forwarded.
;
EXPORTS
    EOS_Achievements_AddNotifyAchievementsUnlocked
    EOS_Achievements_AddNotifyAchievementsUnlockedV2
