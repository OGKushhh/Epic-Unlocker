# Pixel/Retro Game palette
COLOR_BG       = "#16162b"
COLOR_CARD     = "#22224a"
COLOR_SHADOW   = "#0d0d1f"
COLOR_PINK     = "#ff2e88"
COLOR_GREEN    = "#22ff88"
COLOR_TEXT     = "#e8e8ff"
COLOR_DIM      = "#8888c2"
COLOR_TRACK    = "#0d0d1f"
COLOR_RED      = "#ff5555"
COLOR_YELLOW   = "#ffe066"
COLOR_LOG_BG   = "#0d0d1f"
COLOR_LOG_TEXT = "#22ff88"

FONT_MONO = ("Consolas", 10)
FONT_MONO_BOLD = ("Consolas", 11, "bold")
FONT_MONO_SMALL = ("Consolas", 9)
FONT_MONO_TITLE = ("Consolas", 14, "bold")
FONT_MONO_LOG = ("Consolas", 9)


class PatcherGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("EOS SDK Patcher v6")
        self.root.configure(bg=COLOR_BG)
        # Allow horizontal resize so buttons never clip; lock vertical (fixed row count)
        self.root.resizable(True, False)
        self.root.minsize(640, 1)   # wide enough for all 6 buttons + log

        self.target_path = None
        self.working = False

        self._build_ui()

        # Set a reasonable default window size
        self.root.update_idletasks()
        w = max(self.root.winfo_width(), 680)
        h = max(self.root.winfo_height(), 650)
        sw = self.root.winfo_screenwidth()
        sh = self.root.winfo_screenheight()
        x = (sw - w) // 2
        y = (sh - h) // 2
        self.root.geometry(f"{w}x{h}+{x}+{y}")

    def _build_ui(self):
        # ─── Card container with 4px hard shadow ────────────────────────────
        card = tk.Frame(self.root, bg=COLOR_SHADOW)
        card.pack(padx=8, pady=8)

        inner = tk.Frame(card, bg=COLOR_CARD, highlightbackground=COLOR_SHADOW,
                         highlightthickness=4)
        inner.pack(padx=4, pady=4)

        # ─── Header: kicker + title + description ───────────────────────────
        header = tk.Frame(inner, bg=COLOR_CARD)
        header.pack(fill="x", padx=22, pady=(20, 0))

        kicker = tk.Label(header, text=">> EOS PATCHER v6", bg=COLOR_CARD,
                          fg=COLOR_PINK, font=FONT_MONO_SMALL)
        kicker.pack(anchor="w")

        title = tk.Label(header, text="PATCH THE SDK", bg=COLOR_CARD,
                         fg=COLOR_TEXT, font=FONT_MONO_TITLE)
        title.pack(anchor="w", pady=(6, 0))

        desc = tk.Label(header, text=(
            "Applies OnlineFix-style EAC silencer + validation bypass\n"
            "patches to the EOS SDK DLL on disk."
        ), bg=COLOR_CARD, fg=COLOR_DIM, font=FONT_MONO_SMALL,
           anchor="w", justify="left")
        desc.pack(anchor="w", pady=(6, 0))

        # ─── Buttons row (at the TOP — immediately visible) ────────────────
        btn_frame = tk.Frame(inner, bg=COLOR_CARD)
        btn_frame.pack(fill="x", padx=22, pady=(16, 0))

        self.btn_browse = self._make_pixel_button(btn_frame, "BROWSE",
                                                    COLOR_GREEN, COLOR_SHADOW,
                                                    self._on_browse)

        self.btn_smart = self._make_pixel_button(btn_frame, "SMART INSTALL",
                                                    COLOR_YELLOW, COLOR_SHADOW,
                                                    self._on_smart_install)

        self.btn_patch = self._make_pixel_button(btn_frame, "PATCH!",
                                                   COLOR_GREEN, COLOR_SHADOW,
                                                   self._on_patch)

        self.btn_restore = self._make_pixel_button(btn_frame, "RESTORE",
                                                     COLOR_PINK, COLOR_SHADOW,
                                                     self._on_restore)

        self.btn_clear = self._make_pixel_button(btn_frame, "CLEAR LOG",
                                                   COLOR_DIM, COLOR_SHADOW,
                                                   self._on_clear_log)

        self.btn_quit = self._make_pixel_button(btn_frame, "QUIT",
                                                  COLOR_PINK, COLOR_SHADOW,
                                                  self.root.destroy)

        # ─── File display ───────────────────────────────────────────────────
        self.file_var = tk.StringVar(value=">> NO FILE SELECTED")
        self.file_label = tk.Label(inner, textvariable=self.file_var,
                                    bg=COLOR_CARD, fg=COLOR_YELLOW,
                                    font=FONT_MONO_SMALL, anchor="w",
                                    justify="left", wraplength=420)
        self.file_label.pack(anchor="w", padx=22, pady=(14, 0))

        # ─── Status display ─────────────────────────────────────────────────
        self.status_var = tk.StringVar(value=">> CLICK BROWSE TO START")
        self.status_label = tk.Label(inner, textvariable=self.status_var,
                                      bg=COLOR_CARD, fg=COLOR_GREEN,
                                      font=FONT_MONO_BOLD, anchor="w",
                                      justify="left", wraplength=420)
        self.status_label.pack(anchor="w", padx=22, pady=(6, 0))

        # ─── Progress track (pixel-art chunked look) ───────────────────────
        track_outer = tk.Frame(inner, bg=COLOR_CARD, highlightbackground=COLOR_SHADOW,
                                highlightthickness=3)
        track_outer.pack(fill="x", padx=22, pady=(14, 0))

        track_inner = tk.Frame(track_outer, bg=COLOR_TRACK,
                                highlightbackground=COLOR_CARD, highlightthickness=3)
        track_inner.pack(fill="x", padx=3, pady=3)

        self.fill_var = tk.DoubleVar(value=0.0)
        self.fill_bar = tk.Frame(track_inner, bg=COLOR_GREEN, height=14)
        self.fill_bar.pack(side="left", fill="y")
        self._update_fill()

        # ─── Progress meta ──────────────────────────────────────────────────
        self.meta_var = tk.StringVar(value="0%   ·   idle   ·   ░░░░░░░░")
        meta = tk.Label(inner, textvariable=self.meta_var, bg=COLOR_CARD,
                         fg=COLOR_DIM, font=FONT_MONO_SMALL, anchor="w")
        meta.pack(anchor="w", padx=22, pady=(8, 0))

        # ─── Log area (at the BOTTOM — shows detailed output) ──────────────
        log_label = tk.Label(inner, text=">> LOG", bg=COLOR_CARD,
                             fg=COLOR_PINK, font=FONT_MONO_SMALL, anchor="w")
        log_label.pack(anchor="w", padx=22, pady=(12, 0))

        log_frame = tk.Frame(inner, bg=COLOR_SHADOW, highlightbackground=COLOR_SHADOW,
                              highlightthickness=2)
        log_frame.pack(fill="x", padx=22, pady=(4, 20))

        self.log_text = scrolledtext.ScrolledText(
            log_frame, height=12, width=60,
            bg=COLOR_LOG_BG, fg=COLOR_LOG_TEXT,
            font=FONT_MONO_LOG, relief="flat",
            insertbackground=COLOR_GREEN,
            selectbackground=COLOR_PINK, selectforeground=COLOR_SHADOW,
            wrap="word", state="disabled"
        )
        self.log_text.pack(padx=2, pady=2, fill="x")
        # Initial log message
        self._log_line(">> PATCHER READY — waiting for file selection...")
        self._log_line(">> Click BROWSE above to select an EOSSDK-Win64-Shipping DLL.")

        self.btn_patch.configure(state="disabled")
        self.btn_restore.configure(state="disabled")

    def _make_pixel_button(self, parent, text, bg, shadow_color, command):
        """Pixel-art button: monospace bold, flat relief, hard color contrast.
        The 4px shadow effect is simulated via relief + borderwidth."""
        btn = tk.Button(parent, text=text, bg=bg, fg=COLOR_SHADOW,
                         font=FONT_MONO_BOLD, relief="flat",
                         activebackground=bg, activeforeground=COLOR_SHADOW,
                         disabledforeground="#8888c2",
                         padx=18, pady=8, cursor="hand2",
                         command=command, borderwidth=0,
                         highlightthickness=2,
                         highlightbackground=shadow_color,
                         highlightcolor=shadow_color)
        btn.pack(side="left", padx=(0, 8))
        return btn

    def _update_fill(self):
        pct = self.fill_var.get()
        self.fill_bar.master.update_idletasks()
        track_w = self.fill_bar.master.winfo_width()
        if track_w <= 1:
            self.root.after(50, self._update_fill)
            return
        fill_w = max(1, int(track_w * pct))
        self.fill_bar.configure(width=fill_w)

    def _set_progress(self, pct, status="", meta=""):
        self.fill_var.set(pct)
        self._update_fill()
        if status:
            self.status_var.set(status)
        if meta:
            blocks = int(pct * 8)
            bar = "█" * blocks + "░" * (8 - blocks)
            self.meta_var.set(f"{int(pct*100)}%   ·   {meta}   ·   {bar}")
        else:
            self.meta_var.set(f"{int(pct*100)}%")

    def _set_status(self, text, color=COLOR_GREEN):
        self.status_var.set(text)
        self.status_label.configure(fg=color)

    def _log_line(self, msg):
        """Append a line to the log widget. Thread-safe via after()."""
        def do_append():
            self.log_text.configure(state="normal")
            self.log_text.insert("end", msg + "\n")
            self.log_text.see("end")
            self.log_text.configure(state="disabled")
        # If we're on the main thread, do it directly; otherwise schedule it
        if threading.current_thread() is threading.main_thread():
            do_append()
        else:
            self.root.after(0, do_append)

    def _on_clear_log(self):
        self.log_text.configure(state="normal")
        self.log_text.delete("1.0", "end")
        self.log_text.configure(state="disabled")

    def _on_browse(self):
        if self.working:
            return
        path = filedialog.askopenfilename(
            title="Select EOSSDK-Win64-Shipping.dll",
            filetypes=[("EOS SDK DLL", "EOSSDK-Win64-Shipping*.dll"), ("All files", "*.*")]
        )
        if not path:
            return
        self.target_path = path
        short = os.path.basename(path)
        self.file_var.set(f">> FILE: {short}")
        self._set_status(">> FILE LOADED — click PATCH! to begin", COLOR_GREEN)
        self._set_progress(0.0, ">> READY TO PATCH", "ready")
        self._log_line("")
        self._log_line(f">> FILE SELECTED: {short}")
        self._log_line(f"   Path: {path}")
        self._log_line(f"   Size: {os.path.getsize(path):,} bytes")
        self._log_line(f"   SHA:  {sha256_file(path)[:32]}...")
        backup = path + ".eosbak"
        if os.path.exists(backup):
            self._log_line(f"   NOTE: Backup exists ({os.path.basename(backup)})")
            self.btn_restore.configure(state="normal")
        else:
            self._log_line(f"   No backup yet — will create .eosbak on patch")
            self.btn_restore.configure(state="disabled")
        self.btn_patch.configure(state="normal")

    def _on_smart_install(self):
        """Smart install: installs bundled OnlineFix cert files into the
        game's EasyAntiCheat/Certificates/ folder. Optionally also patches
        the SDK if the user confirms."""
        if self.working:
            return
        # If no file selected yet, ask for one first
        if not self.target_path:
            path = filedialog.askopenfilename(
                title="Select EOSSDK-Win64-Shipping.dll (to locate the game's EasyAntiCheat folder)",
                filetypes=[("EOS SDK DLL", "EOSSDK-Win64-Shipping*.dll"), ("All files", "*.*")]
            )
            if not path:
                return
            self.target_path = path
            short = os.path.basename(path)
            self.file_var.set(f">> FILE: {short}")
            self._log_line(f">> FILE SELECTED: {short}")
            self._log_line(f"   Path: {path}")
            self.btn_patch.configure(state="normal")
            backup = path + ".eosbak"
            self.btn_restore.configure(state="normal" if os.path.exists(backup) else "disabled")

        # Run the smart install in a background thread
        self.working = True
        self._disable_buttons()
        self._set_status(">> SMART INSTALL STARTING...", COLOR_YELLOW)
        self._set_progress(0.0, ">> SMART INSTALL...", "starting")
        self._log_line("")
        self._log_line("=" * 50)
        self._log_line(">> SMART INSTALL: OnlineFix cert files + optional SDK patches")
        threading.Thread(target=self._do_smart_install, daemon=True).start()

    def _do_smart_install(self):
        """Background thread: install cert files, then optionally patch SDK."""
        try:
            path = self.target_path
            self._log_line(f">> Locating EasyAntiCheat folder from: {os.path.basename(path)}")

            # Step 1: Find the EasyAntiCheat folder by walking up from the SDK path
            self.root.after(0, lambda: self._set_progress(0.10, ">> SEARCHING FOR EASYANTICHEAT FOLDER...", "searching"))
            time.sleep(0.1)
            eac_folder = find_eac_folder(path)

            if not eac_folder:
                self._log_line("  [!] EasyAntiCheat folder NOT found near the SDK")
                self._log_line("  [!] Try selecting the SDK DLL inside the game's Binaries/Win64/ folder")
                self.root.after(0, lambda: self._set_progress(0.0, ">> EASYANTICHEAT FOLDER NOT FOUND", "error"))
                self.root.after(0, lambda: self._set_status(">> FOLDER NOT FOUND", COLOR_RED))
                return

            certs_dir = os.path.join(eac_folder, 'Certificates')
            self._log_line(f"  [+] Found EasyAntiCheat folder: {eac_folder}")
            self._log_line(f"  [+] Certificates target: {certs_dir}")
            self.root.after(0, lambda: self._set_progress(0.30, ">> INSTALLING CERT FILES...", "certs"))

            # Step 2: Install the bundled cert files
            ok, installed = install_bundled_certs(certs_dir, log=self._log_line)
            if not ok or not installed:
                self._log_line("  [!] Failed to install cert files")
                self.root.after(0, lambda: self._set_progress(0.0, ">> CERT INSTALL FAILED", "error"))
                self.root.after(0, lambda: self._set_status(">> CERT INSTALL FAILED", COLOR_RED))
                return

            self._log_line(f"  [+] Installed {len(installed)} cert file(s): {', '.join(installed)}")
            self.root.after(0, lambda: self._set_progress(0.60, ">> CERTS INSTALLED", "certs-done"))

            # Step 3: Ask if user also wants SDK patches
            self._log_line("")
            self._log_line(">> Cert files installed — achievements should unlock now!")
            self._log_line(">> Optional: also apply SDK patches for 'strict' games?")
            self._log_line(">> (Patches are harmless but usually unnecessary — cert-only works)")

            # Use a simple messagebox-style prompt via after() to run on main thread
            import tkinter.messagebox as mb
            do_patches = [False]
            def ask_patches():
                do_patches[0] = mb.askyesno(
                    "Optional SDK Patches",
                    "Cert files installed successfully!\n\n"
                    "Optional: also apply SDK patches for 'strict' games?\n"
                    "(Patches are harmless but usually unnecessary — cert-only works)\n\n"
                    "Apply SDK patches?"
                )
            self.root.after(0, ask_patches)
            # Wait for the user's answer (poll until the dialog returns)
            while self.root.state() and do_patches[0] is False:
                time.sleep(0.05)
                # The dialog blocks on main thread, so we just wait
                break  # Actually messagebox blocks, so by the time we get here it's done

            if do_patches[0]:
                self._log_line(">> User chose: YES — applying SDK patches")
                self.root.after(0, lambda: self._set_progress(0.70, ">> PATCHING SDK...", "patching"))
                time.sleep(0.1)

                # Read the SDK file
                with open(path, 'rb') as f:
                    data = bytearray(f.read())
                secs = parse_sections(data)

                # Backup
                backup = path + ".eosbak"
                if not os.path.exists(backup):
                    shutil.copy2(path, backup)
                    self._log_line(f"  [+] Created backup: {os.path.basename(backup)}")
                else:
                    self._log_line(f"  [+] Backup exists: {os.path.basename(backup)}")

                # Site 1
                self._log_line("")
                self._log_line("[1] Patch Site 1 — ShouldUseNullAntiCheatClient (EAC silencer)")
                s1_ok, s1_msg = apply_site1(data, secs, log=self._log_line)
                self._log_line(f"  => {'SUCCESS' if s1_ok else 'SKIPPED'}: {s1_msg}")

                # Site 2
                self._log_line("")
                self._log_line("[2] Patch Site 2 — SubmitServerValidationRequest (validation bypass)")
                s2_ok, s2_msg = apply_site2(data, secs, log=self._log_line)
                self._log_line(f"  => {'SUCCESS' if s2_ok else 'SKIPPED'}: {s2_msg}")

                if s1_ok or s2_ok:
                    with open(path, 'wb') as f:
                        f.write(data)
                    self._log_line(f"  [+] Wrote patched SDK to disk")
                    self.root.after(0, lambda: self.btn_restore.configure(state="normal"))
            else:
                self._log_line(">> User chose: NO — skipping SDK patches (cert-only)")

            # Done
            self.root.after(0, lambda: self._set_progress(1.0, ">> SMART INSTALL COMPLETE!", "done"))
            self.root.after(0, lambda: self._set_status(">> SMART INSTALL COMPLETE!", COLOR_GREEN))
            self._log_line("")
            self._log_line("=" * 50)
            self._log_line(">> SMART INSTALL COMPLETE!")
            self._log_line(f"   Cert files: installed ({len(installed)} files)")
            if do_patches[0]:
                self._log_line(f"   SDK patches: applied")
            else:
                self._log_line(f"   SDK patches: skipped (cert-only)")
            self._log_line(">> Launch the game from Epic Games Launcher.")

        except Exception as e:
            self.root.after(0, lambda: self._set_progress(0.0, ">> ERROR", "error"))
            self.root.after(0, lambda: self._set_status(f">> ERROR: {e}", COLOR_RED))
            self._log_line("")
            self._log_line(f">> ERROR: {e}")
            import traceback
            self._log_line(traceback.format_exc())
        finally:
            self.working = False
            self.root.after(0, self._enable_buttons)

    def _on_patch(self):
        if self.working or not self.target_path:
            return
        self.working = True
        self._disable_buttons()
        self._set_status(">> READING FILE...", COLOR_YELLOW)
        self._set_progress(0.05, ">> READING FILE...", "reading")
        self._log_line("")
        self._log_line("=" * 50)
        self._log_line(">> STARTING PATCH OPERATION")
        threading.Thread(target=self._do_patch, daemon=True).start()

    def _do_patch(self):
        try:
            path = self.target_path
            sz = os.path.getsize(path)
            sha = sha256_file(path)

            self.root.after(0, lambda: self._set_progress(0.15, ">> READING FILE INTO MEMORY...", "loading"))
            time.sleep(0.1)

            with open(path, 'rb') as f:
                data = bytearray(f.read())

            self.root.after(0, lambda: self._set_progress(0.30, ">> PARSING PE SECTIONS...", "parsing"))
            time.sleep(0.1)
            secs = parse_sections(data)
            self._log_line(f"   Parsed {len(secs)} PE sections")

            # Backup
            backup = path + ".eosbak"
            if not os.path.exists(backup):
                self.root.after(0, lambda: self._set_progress(0.40, ">> CREATING BACKUP...", "backup"))
                self._log_line(f"   Creating backup: {os.path.basename(backup)}")
                shutil.copy2(path, backup)
                time.sleep(0.1)
            else:
                self._log_line(f"   Backup already exists: {os.path.basename(backup)}")
                time.sleep(0.1)

            # Site 1
            self._log_line("")
            self._log_line("[1] Patch Site 1 — ShouldUseNullAntiCheatClient (EAC silencer)")
            self._log_line("    Target: forces SDK to load AntiCheatClientNull (stub)")
            self.root.after(0, lambda: self._set_progress(0.55, ">> PATCH SITE 1 (EAC SILENCER)...", "site1"))
            time.sleep(0.1)
            s1_ok, s1_msg = apply_site1(data, secs, log=self._log_line)
            self.root.after(0, lambda: self._set_status(
                f">> SITE 1: {'OK' if s1_ok else 'SKIPPED'}",
                COLOR_GREEN if s1_ok else COLOR_YELLOW))
            self._log_line(f"  => {'SUCCESS' if s1_ok else 'SKIPPED'}: {s1_msg}")

            # Site 2
            self._log_line("")
            self._log_line("[2] Patch Site 2 — SubmitServerValidationRequest (validation bypass)")
            self._log_line("    Target: forces validation roundtrips to always 'succeed'")
            self.root.after(0, lambda: self._set_progress(0.75, ">> PATCH SITE 2 (VALIDATION)...", "site2"))
            time.sleep(0.1)
            s2_ok, s2_msg = apply_site2(data, secs, log=self._log_line)
            self.root.after(0, lambda: self._set_status(
                f">> SITE 2: {'OK' if s2_ok else 'SKIPPED'}",
                COLOR_GREEN if s2_ok else COLOR_YELLOW))
            self._log_line(f"  => {'SUCCESS' if s2_ok else 'SKIPPED'}: {s2_msg}")

            # Write file
            if s1_ok or s2_ok:
                self._log_line("")
                self._log_line(">> WRITING PATCHED FILE TO DISK...")
                self.root.after(0, lambda: self._set_progress(0.90, ">> WRITING FILE...", "writing"))
                with open(path, 'wb') as f:
                    f.write(data)
                time.sleep(0.1)

                new_sha = sha256_file(path)
                self.root.after(0, lambda: self._set_progress(1.0, ">> DONE!", "complete"))
                self.root.after(0, lambda: self._set_status(
                    ">> PATCH COMPLETE!",
                    COLOR_GREEN))
                self._log_line("")
                self._log_line("=" * 50)
                self._log_line(f">> DONE! Site1={'+' if s1_ok else '-'} Site2={'+' if s2_ok else '-'}")
                self._log_line(f"   New SHA: {new_sha[:32]}...")
                self._log_line(f"   Backup:  {os.path.basename(backup)}")
                self._log_line(f"   To undo: click RESTORE button")
                self.root.after(0, lambda: self.btn_restore.configure(state="normal"))
            else:
                self.root.after(0, lambda: self._set_progress(0.0, ">> NO PATCHES APPLIED", "noop"))
                self.root.after(0, lambda: self._set_status(">> NO PATCHES APPLIED", COLOR_RED))
                self._log_line("")
                self._log_line("=" * 50)
                self._log_line(">> NO PATCHES APPLIED — SDK left unchanged")
                self._log_line(f"   Site1: {s1_msg}")
                self._log_line(f"   Site2: {s2_msg}")

        except Exception as e:
            self.root.after(0, lambda: self._set_progress(0.0, ">> ERROR", "error"))
            self.root.after(0, lambda: self._set_status(f">> ERROR: {e}", COLOR_RED))
            self._log_line("")
            self._log_line(f">> ERROR: {e}")
            import traceback
            self._log_line(traceback.format_exc())
        finally:
            self.working = False
            self.root.after(0, self._enable_buttons)

    def _on_restore(self):
        if self.working or not self.target_path:
            return
        path = self.target_path
        backup = path + ".eosbak"
        if not os.path.exists(backup):
            self._set_status(">> NO BACKUP FOUND", COLOR_RED)
            self._log_line(f">> ERROR: No backup found at {os.path.basename(backup)}")
            return
        self.working = True
        self._disable_buttons()
        self._set_status(">> RESTORING...", COLOR_YELLOW)
        self._set_progress(0.5, ">> RESTORING...", "restoring")
        self._log_line("")
        self._log_line("=" * 50)
        self._log_line(">> RESTORING FROM BACKUP")
        self._log_line(f"   Source: {os.path.basename(backup)}")
        self._log_line(f"   Target: {os.path.basename(path)}")
        try:
            shutil.copy2(backup, path)
            new_sha = sha256_file(path)
            self._set_progress(1.0, ">> RESTORED!", "done")
            self._set_status(">> RESTORED!", COLOR_GREEN)
            self._log_line(f"   New SHA: {new_sha[:32]}...")
            self._log_line(">> DONE — original SDK restored")
        except Exception as e:
            self._set_progress(0.0, ">> ERROR", "error")
            self._set_status(f">> ERROR: {e}", COLOR_RED)
            self._log_line(f">> ERROR: {e}")
        finally:
            self.working = False
            self._enable_buttons()

    def _disable_buttons(self):
        for btn in (self.btn_browse, self.btn_smart, self.btn_patch, self.btn_restore, self.btn_clear, self.btn_quit):
            btn.configure(state="disabled")

    def _enable_buttons(self):
        self.btn_browse.configure(state="normal")
        self.btn_smart.configure(state="normal")
        self.btn_clear.configure(state="normal")
        self.btn_quit.configure(state="normal")
        if self.target_path:
            self.btn_patch.configure(state="normal")
            backup = self.target_path + ".eosbak"
            if os.path.exists(backup):
                self.btn_restore.configure(state="normal")


def main():
    root = tk.Tk()
    app = PatcherGUI(root)
    root.mainloop()


if __name__ == "__main__":
    main()
