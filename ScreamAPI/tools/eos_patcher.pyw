#!/usr/bin/env python3
"""
EOS SDK On-Disk Patcher v6 — GUI only (.pyw)
=============================================
Applies two OnlineFix-style binary patches to the EOS SDK DLL on disk:
  Site 1: ShouldUseNullAntiCheatClient() -> TRUE  (EAC silencer)
  Site 2: SubmitServerValidationRequest() -> 0x2EE0 (validation bypass)

NOTE: For confirmed games (Deceive Inc., The Riflemen), patches are OPTIONAL —
      cert files alone work. This tool is only needed for "strict" games that
      enforce EAC runtime reports (kick you mid-match).

Run:
    pythonw eos_patcher.pyw
    (or double-click the .pyw file)

Style: "Pixel / Retro Game" — dark navy, neon pink/green, monospace, 4px shadows.

Requires: Python 3.8+ with tkinter (standard library)
"""

import os
import shutil
import hashlib
import struct
import threading
import time
import tkinter as tk
from tkinter import filedialog, scrolledtext

# ─── Patch constants ─────────────────────────────────────────────────────────

PATCH1 = bytes([0x48,0xC7,0xC0,0x01,0x00,0x00,0x00, 0xC3, 0x90,0x90,0x90])
PATCH2 = bytes([0x48,0xC7,0xC0,0xE0,0x2E,0x00,0x00, 0xC3])
STR = b"EOS_USE_ANTICHEATCLIENTNULL\x00"
SIG_2EE0_32 = bytes([0xB8,0xE0,0x2E,0x00,0x00])
SIG_2EE0_64 = bytes([0x48,0xC7,0xC0,0xE0,0x2E,0x00,0x00])
SITE1_MAX_FUNC_SIZE = 0x100

# ─── Bundled OnlineFix cert files (base64-encoded) ──────────────────────────
#
# base.cer: 1165 bytes — OnlineFix's universal EAC cert (works across games)
B64_BASE_CER = ""

# base.bin: 29459 bytes — OnlineFix's universal EAC cert (works across games)
B64_BASE_BIN = ""

# runtime.conf: 1108 bytes — OnlineFix's universal EAC cert (works across games)
B64_RUNTIME_CONF = ""

# Lookup table: filename → (base64, sha256) for verification
BUNDLED_CERTS = {
    "base.cer": (B64_BASE_CER, "467e2108ab233fc75cce603458d499f760f07d4809b91e09a486fe7e9d8980f4"),
    "base.bin": (B64_BASE_BIN, "54f5dd06d3caa4415b45c82b88ec4110360c9942a10b3ea557bc5286b8318702"),
    "runtime.conf": (B64_RUNTIME_CONF, "a69ebfc3efede2ee31c49f9092701a38b7ac84bcb424208f1393154475ea48ca"),
}

# ─── Patcher logic (with logging callback) ───────────────────────────────────

def parse_sections(data):
    e_lfanew = struct.unpack_from('<I', data, 0x3C)[0]
    coff = e_lfanew + 4
    num = struct.unpack_from('<H', data, coff+2)[0]
    sz_opt = struct.unpack_from('<H', data, coff+16)[0]
    sec_off = coff + 20 + sz_opt
    sections = []
    for i in range(num):
        vsize, vaddr, rsize, raddr = struct.unpack_from('<IIII', data[sec_off+i*40+8:sec_off+i*40+24])
        sections.append((vaddr, vsize, raddr, rsize))
    return sections

def f2va(foff, secs):
    for va, vs, ra, rs in secs:
        if ra <= foff < ra + rs: return va + (foff - ra)
    return None

def find_func_start(data, pos, max_back=0x2000):
    for j in range(pos, max(0, pos - max_back), -1):
        if data[j-1] not in (0xCC, 0xC3, 0x90, 0x00): continue
        if data[j:j+3] == b'\x4C\x8B\xDC': return j
        if data[j:j+5] == b'\x48\x89\x5C\x24\x08': return j
        if data[j:j+2] == b'\x40\x53': return j
        if data[j:j+1] == b'\x55': return j
        if data[j:j+1] == b'\x53': return j
        if data[j:j+4] == b'\x48\x83\xEC': return j
        if data[j:j+4] == b'\x48\x81\xEC': return j
    return -1

def find_func_end(data, start, max_fwd=0x4000):
    for j in range(start, min(len(data), start + max_fwd)):
        if data[j] == 0xC3:
            if j+1 < len(data) and data[j+1] == 0xCC:
                return j + 1
    return -1

def apply_site1(data, secs, log=None):
    """Returns (success, message). Calls log(msg) for detailed progress."""
    def L(msg):
        if log: log(msg)

    str_foff = data.find(STR)
    if str_foff < 0:
        L("  [!] String 'EOS_USE_ANTICHEATCLIENTNULL' NOT FOUND in .rdata")
        return False, "String not found in .rdata"
    str_va = f2va(str_foff, secs)
    L(f"  [+] Env-var string at file 0x{str_foff:X}, VA 0x{str_va:X}")

    text_va, text_vs, text_ra, text_rs = secs[0]
    refs = []
    text_data = data[text_ra:text_ra+text_rs]
    for i in range(len(text_data) - 7):
        if text_data[i] in (0x48, 0x4C) and text_data[i+1] == 0x8D:
            modrm = text_data[i+2]
            if (modrm & 0xC7) == 0x05:
                disp = struct.unpack_from('<i', text_data, i+3)[0]
                target_va = text_va + i + 7 + disp
                if target_va == str_va:
                    refs.append(text_ra + i)

    L(f"  [+] Found {len(refs)} LEA reference(s) to the env-var string")
    if not refs:
        L("  [!] No LEA references found — site 1 unavailable in this SDK")
        return False, "No LEA references to env-var string"

    candidates = []
    for ref in refs:
        func = find_func_start(data, ref)
        if func < 0:
            continue
        end = find_func_end(data, func)
        size = (end - func) if end > 0 else -1
        candidates.append((func, ref, size))

    L(f"  [*] Candidate functions:")
    for func, ref, size in candidates:
        marker = ""
        if 0 < size <= SITE1_MAX_FUNC_SIZE:
            marker = " (valid predicate)"
        elif size > SITE1_MAX_FUNC_SIZE:
            marker = f" (TOO LARGE — {size} bytes, will be skipped)"
        else:
            marker = " (size unknown)"
        L(f"      Func 0x{func:X}, ref 0x{ref:X}, ~{size} bytes{marker}")

    valid = [(f, r, s) for f, r, s in candidates if 0 < s <= SITE1_MAX_FUNC_SIZE]
    if not valid:
        L(f"  [!] No candidate small enough to be a predicate (cap {SITE1_MAX_FUNC_SIZE:#x})")
        L(f"  [!] Use env var EOS_USE_ANTICHEATCLIENTNULL=1 instead of patching")
        return False, f"All {len(candidates)} candidate(s) too large (cap {SITE1_MAX_FUNC_SIZE:#x})"

    valid.sort(key=lambda c: c[2])
    func, ref, size = valid[0]
    L(f"  [+] Selected smallest: 0x{func:X} (~{size} bytes)")

    if data[func:func+len(PATCH1)] == PATCH1:
        L("  [*] Already patched at this offset")
        return True, f"Already patched at 0x{func:X}"

    L(f"  [+] Original bytes: {data[func:func+len(PATCH1)].hex()}")
    data[func:func+len(PATCH1)] = PATCH1
    L(f"  [+] Patched bytes:  {PATCH1.hex()}")
    return True, f"Patched at 0x{func:X} (~{size} bytes)"

def apply_site2(data, secs, log=None):
    """Returns (success, message). Calls log(msg) for detailed progress."""
    def L(msg):
        if log: log(msg)

    m32 = []
    pos = 0
    while True:
        pos = data.find(SIG_2EE0_32, pos)
        if pos < 0: break
        m32.append(pos)
        pos += 1

    m64 = []
    pos = 0
    while True:
        pos = data.find(SIG_2EE0_64, pos)
        if pos < 0: break
        m64.append(pos)
        pos += 1

    all_m = [(m, "mov eax") for m in m32] + [(m, "mov rax") for m in m64]
    L(f"  [+] Found {len(all_m)} occurrence(s) of 0x2EE0 immediate")
    if not all_m:
        L("  [!] No 0x2EE0 immediate found in SDK")
        return False, "No 0x2EE0 immediate found"

    candidates = []
    for off, form in all_m:
        func = find_func_start(data, off)
        if func < 0: continue
        end = find_func_end(data, func)
        size = (end - func) if end > 0 else -1
        candidates.append((func, off, form, size))

    L(f"  [*] Candidate functions:")
    for func, off, form, size in candidates:
        L(f"      Func 0x{func:X}, 0x2EE0 at 0x{off:X} ({form}), ~{size} bytes")

    if not candidates:
        L("  [!] Found 0x2EE0 but no enclosing function prologue")
        return False, "No enclosing function for 0x2EE0"

    known = [c for c in candidates if c[3] > 0]
    if known:
        known.sort(key=lambda c: c[3])
        func, off, form, size = known[0]
        L(f"  [+] Selected smallest: 0x{func:X} (~{size} bytes)")
    else:
        func, off, form, size = candidates[0]
        L(f"  [+] Selected first candidate: 0x{func:X} (size unknown)")

    # Sanity check
    if size > 0 and (off - func) > size:
        L(f"  [!] WARNING: 0x2EE0 at 0x{off:X} is {off - func} bytes into function")
        L(f"  [!]          but estimated size is only {size} — estimate is wrong")

    if data[func:func+len(PATCH2)] == PATCH2:
        L("  [*] Already patched at this offset")
        return True, f"Already patched at 0x{func:X}"

    L(f"  [+] Original bytes: {data[func:func+len(PATCH2)].hex()}")
    data[func:func+len(PATCH2)] = PATCH2
    L(f"  [+] Patched bytes:  {PATCH2.hex()}")
    return True, f"Patched at 0x{func:X} (~{size} bytes)"

def sha256_file(p):
    h = hashlib.sha256()
    with open(p, 'rb') as f:
        for c in iter(lambda: f.read(8192), b''): h.update(c)
    return h.hexdigest()

# ─── Smart install: cert file bundling + auto-detect EasyAntiCheat folder ────

import base64 as _base64

def find_eac_folder(sdk_path):
    """Walk upward from the SDK's directory looking for an 'EasyAntiCheat' folder.
    Returns the absolute path to the EasyAntiCheat folder, or None if not found."""
    p = os.path.dirname(os.path.abspath(sdk_path))
    for _ in range(8):  # max 8 levels up
        candidate = os.path.join(p, 'EasyAntiCheat')
        if os.path.isdir(candidate):
            return candidate
        parent = os.path.dirname(p)
        if parent == p:
            break
        p = parent
    return None

def install_bundled_certs(target_dir, log=None):
    """Write the bundled OnlineFix cert files into target_dir (the Certificates folder).
    Returns (success, list_of_installed_files)."""
    def L(msg):
        if log: log(msg)

    if not os.path.isdir(target_dir):
        L(f"  [!] Target directory does not exist: {target_dir}")
        return False, []

    # Create the directory if needed (game might not have Certificates subfolder)
    os.makedirs(target_dir, exist_ok=True)

    installed = []
    for filename, (b64_data, expected_sha) in BUNDLED_CERTS.items():
        target_path = os.path.join(target_dir, filename)
        raw = _base64.b64decode(b64_data)

        # Verify SHA-256
        import hashlib
        actual_sha = hashlib.sha256(raw).hexdigest()
        if actual_sha != expected_sha:
            L(f"  [!] {filename}: SHA mismatch (expected {expected_sha[:16]}..., got {actual_sha[:16]}...) — skipping")
            continue

        # Back up existing file
        if os.path.exists(target_path):
            backup_path = target_path + '.eosbak'
            shutil.copy2(target_path, backup_path)
            L(f"  [+] Backed up existing {filename} → {os.path.basename(backup_path)}")

        # Write the bundled cert
        with open(target_path, 'wb') as f:
            f.write(raw)
        installed.append(filename)
        L(f"  [+] Wrote {filename} ({len(raw)} bytes)")

    return True, installed

